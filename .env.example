# Environment Configuration Template
# Copy this to .env and fill in your actual values

# ==================== DATABASE ====================
DATABASE_URL=postgresql://wali_user:your_password@localhost:5432/wali
DATABASE_REPLICA_URL=postgresql://wali_user:your_password@localhost:5433/wali

# ==================== REDIS ====================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ==================== JWT ====================
JWT_SECRET=generate_a_64_byte_random_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==================== ORANGE MONEY CI ====================
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_API_URL=https://api.orange.com
ORANGE_MERCHANT_CODE=

# ==================== MTN MOMO ====================
MTN_API_USER=
MTN_API_KEY=
MTN_SUBSCRIPTION_KEY=
MTN_TARGET_ENVIRONMENT=sandbox  # Change to 'production' for live
MTN_CALLBACK_URL=https://api.wali.ci/webhooks/mtn/collections

# ==================== WAVE CI ====================
WAVE_API_KEY=
WAVE_SECRET_KEY=
WAVE_CHECKOUT_URL=https://api.wave.com/v1/checkout/sessions

# ==================== MINIO (S3-COMPATIBLE STORAGE) ====================
MINIO_ROOT_USER=wali_admin
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=wali-claims

# ==================== RABBITMQ ====================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE_PAYMENTS=payment_events
RABBITMQ_QUEUE_NOTIFICATIONS=notification_events

# ==================== COMPLIANCE ====================
ESCROW_BANK_ACCOUNT=CI12345678901234567890  # SGBCI/Ecobank account
OPERATING_BANK_ACCOUNT=CI09876543210987654321
TECH_FEE_PERCENTAGE=2
TAX_EXEMPTION_START_DATE=2026-01-01

# ==================== NOTIFICATIONS ====================
SMS_PROVIDER=orange  # or 'africastalking'
ORANGE_SMS_API_KEY=
ORANGE_SMS_SENDER_ID=Wali
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# ==================== CNPS INTEGRATION ====================
CNPS_API_URL=https://cnps.ci/api
CNPS_API_KEY=

# ==================== SECURITY ====================
ENCRYPTION_KEY=generate_a_32_byte_key_for_aes256
ALLOWED_ORIGINS=https://wali.ci,https://admin.wali.ci
RATE_LIMIT_PER_MINUTE=10

# ==================== ENVIRONMENT ====================
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO
TIMEZONE=Africa/Abidjan
