# Wali B2B SaaS Platform — Environment Configuration
# Copy this to .env and fill in your actual values
#
# Wali is a SOFTWARE VENDOR (NAF 6201Z), NOT an insurer or broker.

# ==================== DATABASE ====================
DATABASE_URL=postgresql://wali_user:your_password@localhost:5432/wali
DATABASE_REPLICA_URL=postgresql://wali_user:your_password@localhost:5433/wali

# ==================== REDIS ====================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ==================== JWT ====================
JWT_SECRET=generate_a_64_byte_random_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==================== SAAS PLATFORM ====================
IS_SAAS_PLATFORM=true
BUSINESS_MODEL=B2B_SAAS
NAF_CODE=6201Z
ACTIVITE_PRINCIPALE=Prestation de services informatiques

# ==================== PARTNER INSURER ====================
DEFAULT_PARTNER_ID=NSIA
PARTNER_MONTHLY_LICENSE_FEE=500000
PARTNER_COLLECTION_ACCOUNT=

# ==================== PAYDUNYA (Payment Routing) ====================
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# ==================== ORANGE MONEY (Payment Routing) ====================
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_API_URL=https://api.orange.com
ORANGE_MERCHANT_CODE=

# ==================== MTN MOMO (Payment Routing) ====================
MTN_API_USER=
MTN_API_KEY=
MTN_SUBSCRIPTION_KEY=
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CALLBACK_URL=https://api.wali.ci/webhooks/mtn/collections

# ==================== WAVE (Payment Routing) ====================
WAVE_API_KEY=
WAVE_SECRET_KEY=
WAVE_CHECKOUT_URL=https://api.wave.com/v1/checkout/sessions

# ==================== MINIO (Incident Report Photos) ====================
MINIO_ROOT_USER=wali_admin
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=incident-reports

# ==================== RABBITMQ ====================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE_PAYMENTS=payment_events
RABBITMQ_QUEUE_NOTIFICATIONS=notification_events

# ==================== TAX EXEMPTION ====================
TAX_EXEMPTION_START_DATE=2026-01-01

# ==================== NOTIFICATIONS ====================
SMS_PROVIDER=orange
ORANGE_SMS_API_KEY=
ORANGE_SMS_SENDER_ID=Wali

# ==================== CNPS INTEGRATION ====================
CNPS_API_URL=https://cnps.ci/api
CNPS_API_KEY=

# ==================== SECURITY ====================
ENCRYPTION_KEY=generate_a_32_byte_key_for_aes256
ALLOWED_ORIGINS=https://wali.ci,https://admin.wali.ci
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ==================== ENVIRONMENT ====================
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Africa/Abidjan
MOCK_PAYMENT_PROVIDERS=true

# ==================== SECURITY & ADMIN ALERTS ====================
# Admin alert configuration for critical failures (settlement, security, etc.)
ADMIN_ALERT_WEBHOOK_URL=           # Webhook URL for critical alerts (Slack/PagerDuty)
ADMIN_ALERT_PHONE=                 # Phone number for SMS critical alerts (+225...)

# Demo account creation (DEVELOPMENT ONLY - set to 'true' to enable)
ALLOW_DEMO_ACCOUNT_CREATION=false  # NEVER enable in production!

# ==================== REMOVED (Insurance Model) ====================
# The following variables were REMOVED during the SaaS refactor:
# ESCROW_BANK_ACCOUNT=       ← Wali doesn't hold escrow (payments route to partner)
# OPERATING_BANK_ACCOUNT=    ← No operating account for premiums
# TECH_FEE_PERCENTAGE=       ← Flat SaaS fee, not commission
# AFRICASTALKING_API_KEY=    ← Removed dependency
# AFRICASTALKING_USERNAME=   ← Removed dependency
