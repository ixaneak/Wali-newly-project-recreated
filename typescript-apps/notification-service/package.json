        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/cors": "^2.8.17",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.11.5",
        "typescript": "^5.3.3",
        "ts-node-dev": "^2.0.0"
